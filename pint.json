{
    "$schema": "https://raw.githubusercontent.com/open-southeners/vscode-laravel-pint/main/pint-schema.json",
    "preset": "laravel",
    "exclude": ["node_modules", "public", "storage", "vendor"],
    "rules": {
        "concat_space": { "spacing": "one" },
        "types_spaces": {
            "space": "single",
            "space_multiple_catch": "single"
        },
        "phpdoc_separation": {
            "groups": [
                ["deprecated", "link", "see", "since"],
                ["author", "copyright", "license"],
                ["category", "package", "subpackage"],
                ["property", "property-read", "property-write"],
                ["param"],
                ["return"]
            ]
        }
    }
}
